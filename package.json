{
	"name": "character-factory",
	"version": "1.1.0",
	"license": "MIT",
	"description": "A Lorelei avatar advanced builder (Documentation is in French unfortunately 🥀).",
	"repository": {
		"type": "git",
		"url": "https://github.com/fox3000foxy/character-factory"
	},
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"scripts": {
		"prepack": "npm run build",
		"build:watch": "tsc --watch",
		"typecheck": "tsc --noEmit",
		"example": "ts-node --esm examples/example.ts",
		"format": "bunx --bun @biomejs/biome format --write ./src",
		"check": "bunx --bun @biomejs/biome check ./src",
		"lint": "bunx --bun @biomejs/biome lint ./src",
		"lint:write": "bunx --bun @biomejs/biome lint --write ./src",
		"build": "tsc --project tsconfig.json",
		"deploy:npm": "npm publish --access public",
		"publish-package": "bash ./scripts/publish-package.sh"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@faker-js/faker": "^10.4.0",
		"@types/bun": "^1.3.14",
		"@types/node": "^26.0.0"
	},
	"peerDependencies": {
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"@dicebear/collection": "^9.4.2",
		"@dicebear/core": "^10.3.0",
		"sharp": "^0.34.5"
	}
}
